# ─────────────────────────────────────────────
# Trades Platform — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# For local development, use direct connection
DATABASE_URL=postgresql://trades:trades_dev_password@localhost:15432/trades_platform
# For production/Vercel, DATABASE_URL should point to pgbouncer (Supabase pooler on port 6543)
# Example: postgresql://user:password@db.xxxxx.supabase.co:6543/postgres

# DIRECT_URL is used for migrations - always direct connection (no pooler)
# For local: same as DATABASE_URL
# For production: direct connection to database (port 5432)
# Example: postgresql://user:password@db.xxxxx.supabase.co:5432/postgres
DIRECT_URL=postgresql://trades:trades_dev_password@localhost:15432/trades_platform

# ── Supabase Storage (for credential uploads) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:16379

# ── Auth0 ─────────────────────────────────────
# Get these from auth0.com — create a new tenant
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://api.trades-platform.ca
AUTH0_BASE_URL=http://localhost:3000

# ── Anthropic (AI content screening) ─────────
# Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Open Badges (credential issuance) ────────
# Badgr API or your own issuer endpoint
OPENBADGE_ISSUER_ID=https://api.trades-platform.ca/issuers/main
OPENBADGE_SIGNING_KEY=your_signing_private_key_here

# ── App ───────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Dev Mode (global flag for development features & lowered thresholds) ──
# Single source of truth for ALL dev-mode behaviors in the app
# When true: Shows dev UI banners, enables test auth flow, uses easier gate thresholds:
#   - Endorsement min contributions: 2 (instead of 20)
#   - Endorsement min reputation: 20 (instead of 50)
#   - Endorsement min account age: 0 days (instead of 60)
# When false: Production-ready with strict gates and Auth0-only authentication
NEXT_PUBLIC_DEV_MODE=false

# ── Security ──────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string_in_production
COOKIE_DOMAIN=localhost

# ── Feature Flags ─────────────────────────────
FEATURE_MENTORSHIP_ENABLED=false
FEATURE_TRAINING_MARKETPLACE=false
FEATURE_EMPLOYER_PORTAL=false
